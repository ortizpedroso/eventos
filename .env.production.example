# =============================================================================
# EventosBR — produção (VPS Hostinger) — domínio eventosbr.app.br
# Copie para .env na raiz do servidor:  cp .env.production.example .env
# Gere secrets: ./scripts/generate-secrets.sh  (ou generate-secrets.ps1 no Windows)
# =============================================================================

# --- Domínio (Caddy + URLs públicas) ---
DOMAIN=eventosbr.app.br
ACME_EMAIL=admin@eventosbr.app.br
NEXT_PUBLIC_API_URL=https://eventosbr.app.br
FRONTEND_PUBLIC_URL=https://eventosbr.app.br
NEXT_PUBLIC_PAYMENT_PROVIDER=asaas
NEXT_PUBLIC_PLATFORM_DOMAIN=eventosbr.app.br

# --- Uploads (logo, favicon, fotos) ---
UPLOAD_DIR=/app/uploads
UPLOAD_PUBLIC_BASE_URL=https://eventosbr.app.br
PLATFORM_BASE_DOMAIN=eventosbr.app.br
NEXT_PUBLIC_LOGO_URL=
NEXT_PUBLIC_SOCIAL_INSTAGRAM_URL=
NEXT_PUBLIC_SOCIAL_WHATSAPP_URL=
NEXT_PUBLIC_EMAIL_CONTATO=contato@eventosbr.app.br
# Telefone/WhatsApp público (rodapé + botão em /contato). DDD + número, só dígitos.
TELEFONE_CONTATO=
NEXT_PUBLIC_TELEFONE_CONTATO=
NEXT_PUBLIC_SOCIAL_WHATSAPP_URL=
# E-mail da conta de login do dono da plataforma (recebe is_platform_admin no boot)
PLATFORM_OWNER_EMAIL=
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# --- OAuth (opcional — Google Sign In) ---
GOOGLE_OAUTH_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=

# --- Postgres ---
POSTGRES_PASSWORD=GERE_SENHA_FORTE_AQUI

# --- Pagamentos — Asaas (único provedor) ---
PAYMENT_PROVIDER=asaas
# Chaves Asaas contêm $ — no .env do VPS cada $ vira $$ (ex.: $$aact_prod_...)
ASAAS_API_KEY=$$aact_prod_...
ASAAS_WEBHOOK_TOKEN=GERE_TOKEN_FORTE_PARA_WEBHOOK
ASAAS_ENVIRONMENT=production
ASAAS_DISABLED=false
ASAAS_PLATFORM_WALLET_ID=
ASAAS_CREATE_SUBACCOUNT_ON_REGISTER=false
ASAAS_ALLOW_MANUAL_WALLET=false
# Conta de recebimento criada pela plataforma (modo baas — único em produção)
ASAAS_ONBOARDING_MODE=baas

# Backups (gitignored — ver exemplos na raiz):
#   .env.prod-backup               ← produção completa (backup-prod-env.sh)
#   .env.asaas-prod-backup         ← subset pagamentos (gerado junto)
# Templates: .env.prod-backup.example, .env.asaas-prod-backup.example

# --- JWT / Admin ---
SECRET_KEY=GERE_COM_scripts/generate-secrets.sh
PLATFORM_ADMIN_API_KEY=GERE_COM_scripts/generate-secrets.sh

# --- E-mail ---
# Hostinger: porta 465 + SSL costuma ser mais estável que 587 + STARTTLS em Docker.
EMAIL_SERVER=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_USER=contato@eventosbr.app.br
EMAIL_PASSWORD=
EMAIL_FROM_NAME=EventosBR
EMAIL_USE_TLS=false
EMAIL_USE_SSL=true

# --- Redis ---
REDIS_URL=redis://redis:6379
RATE_LIMIT_USE_REDIS=true
TICKET_EMAIL_USE_REDIS=true

# --- CORS (inclua apex e www — Caddy redireciona www → apex) ---
CORS_ORIGINS=https://eventosbr.app.br,https://www.eventosbr.app.br

# --- Segurança / ambiente ---
TRUST_FORWARDED_HEADERS=true
ENVIRONMENT=production
DEBUG=False

# --- Cloudflare Turnstile (CAPTCHA — recomendado em produção) ---
# Painel: https://dash.cloudflare.com/?to=/:account/turnstile
# Site key (pública) do widget EventosBR:
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAEEo9-dlOUxCWAz5
# Secret (só no servidor — NÃO commitar valor real):
TURNSTILE_SECRET=
# Legado (opcional): TURNSTILE_SECRET_KEY=  — mesmo valor que TURNSTILE_SECRET
# Configure: ./scripts/wire-existing-turnstile.sh ou ./scripts/configure-turnstile-env.sh

# --- Marketing / Ads (Facebook / Instagram) ---
# Só carregam scripts em produção quando definidos no build do `web`
# NEXT_PUBLIC_META_PIXEL_ID=
# NEXT_PUBLIC_GTM_ID=

# Scripts: configure-asaas-env.sh, configure-turnstile-env.sh, backup-postgres-cron.sh, monitor-ready.sh, verify-production.sh
# Docs: docs/11-go-live-asaas.md, docs/08-deploy-hostinger.md
