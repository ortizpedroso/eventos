# Reverse proxy — HTTPS automático (Let's Encrypt).
# Defina no .env: DOMAIN=seudominio.com.br  ACME_EMAIL=admin@seudominio.com.br
#
# /api/admin/session e /api/admin/proxy/* (qualquer profundidade) → Next.js
# /api/* (resto) → API FastAPI (pagamentos, webhooks Asaas, etc.)
# /health e /ready → readiness/liveness para monitoramento externo
# resto → Next.js

{
	email {$ACME_EMAIL}
}

# Redireciona www → apex (CORS já inclui ambos no .env)
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	encode gzip zstd

	@health path /health /ready
	handle @health {
		reverse_proxy api:8000
	}

	# Rotas do próprio Next.js (não do FastAPI) — precisam vir ANTES da regra
	# genérica @api abaixo, senão o Caddy manda tudo /api/* pro backend e essas
	# nunca são alcançadas (bug: painel admin mostrava "Not Found").
	#
	# IMPORTANTE: `path /api/admin/proxy/**` NÃO cobre subcaminhos no Caddy 2 —
	# só `/api/admin/proxy/setup` (1 segmento) ia pro Next.js; rotas como
	# `/api/admin/proxy/marketing/contatos` caíam no FastAPI (404). Usar regexp.
	@admin_frontend {
		path /api/admin/session
		path_regexp ^/api/admin/proxy(/|$)
	}
	handle @admin_frontend {
		reverse_proxy web:3000
	}

	@api path /api/*
	handle @api {
		reverse_proxy api:8000
	}

	@uploads path /uploads/*
	handle @uploads {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:3000
	}
}
