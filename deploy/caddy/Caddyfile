# Reverse proxy — HTTPS automático (Let's Encrypt).
# Defina no .env: DOMAIN=seudominio.com.br  ACME_EMAIL=admin@seudominio.com.br
#
# /api/admin/session e /api/admin/proxy/* (qualquer profundidade) → Next.js
# /api/* (resto) → API FastAPI (pagamentos, webhooks Asaas, etc.)
# /health e /ready → readiness/liveness para monitoramento externo
# resto → Next.js
{
	email {$ACME_EMAIL}
}

# Redireciona www → apex (CORS já inclui ambos no .env)
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	encode gzip zstd

	@health path /health /ready
	handle @health {
		reverse_proxy api:8000
	}

	# Rotas do PRÓPRIO Next.js (session, proxy, revalidate-platform).
	# Precisam vir ANTES de @api, senão o Caddy manda /api/* direto pro FastAPI.
	#
	# ATENÇÃO — dois erros comuns que causam "Not Found" no painel admin:
	# 1) `/api/admin/proxy/*`  → só 1 segmento (/proxy/setup), não /proxy/marketing/contatos
	# 2) `/api/admin/proxy/**` → glob inválido no matcher `path` do Caddy 2
	# 3) path + path_regexp no MESMO @matcher → AND (impossível casar)
	#
	# Correto: prefixo `/api/admin/proxy*` (Caddy: /foo* casa /foo/bar/baz).
	@admin_frontend path /api/admin/session /api/admin/proxy* /api/admin/revalidate-platform
	handle @admin_frontend {
		reverse_proxy eventosbr_web:3000
	}

	@api path /api/*
	handle @api {
		reverse_proxy api:8000
	}

	@uploads path /uploads/*
	handle @uploads {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy eventosbr_web:3000
	}
}

# -----------------------------------------------------------------------------
# Sites de OUTROS apps que rodam no MESMO VPS/IP. Este Caddy é o único proxy de
# borda (dono das portas 80/443), então precisa conhecer todos os domínios que
# apontam para este IP. Cada domínio tem um bloco EXPLÍCITO; não há site
# "default"/catch-all, logo um Host desconhecido recebe 404 e NUNCA cai por
# engano em outro app.
#
# Por que versionado aqui: o `scripts/deploy-vps.sh` (git checkout/pull) restaura
# este arquivo a partir do git. Se o bloco ficasse só como edição manual/hook no
# servidor, qualquer deploy o apagaria e `eventosbr.app.br` voltaria a exibir o
# SIGEP. Mantendo-o no git, o roteamento sobrevive a qualquer deploy.
#
# O hook do SIGEP (`/opt/sigep-forca/deploy/hook-eventosbr-caddy.sh`) é idempotente
# e apenas SUBSTITUI o bloco marcado logo abaixo — por isso a linha de marcação
# imediatamente acima do site precisa ser mantida exatamente como está. NÃO
# repita esse texto de marcação em comentários (o hook casa a 1a ocorrência).
# -----------------------------------------------------------------------------

# Métrica / SIGEP — não remover o bloco do eventosbr
sigep.inovesw.com.br {
	encode gzip zstd
	reverse_proxy metrica_web:3000
}
